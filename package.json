{
  "name": "liturgical-calendar",
  "version": "2.1.0",
  "main": "./dist/index.js",
  "module": "./dist/index.mjs",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "require": "./dist/index.js",
      "import": "./dist/index.mjs"
    }
  },
  "browser": "./dist/index.js",
  "repository": "https://github.com/Sint-Willibrordkerk/liturgical-calendar.git",
  "author": "Sint Willibrordus Stichting",
  "description": "Generate a (local) Catholic liturgical calendar in accordance with the 1960 rubrics.",
  "license": "MIT",
  "scripts": {
    "build": "tsup",
    "start": "pnpm build && node scripts/main.js",
    "test": "vitest",
    "pipeline": "turbo run step13",
    "pipeline:streaming": "node scripts2/pipeline.mjs",
    "step1": "node scripts2/step1.mjs",
    "step2": "node scripts2/step2.mjs",
    "step3": "node scripts2/step3.mjs",
    "step4": "node scripts2/step4.mjs",
    "step5": "node scripts2/step5.mjs",
    "step6": "node scripts2/step6.mjs",
    "step7": "node scripts2/step7.mjs",
    "step8": "node scripts2/step8.mjs",
    "step9": "node scripts2/step9.mjs",
    "step10": "node scripts2/step10.mjs",
    "step11": "node scripts2/step11.mjs",
    "step12": "node scripts2/step12.mjs",
    "step13": "node scripts2/step13.mjs"
  },
  "files": [
    "dist"
  ],
  "dependencies": {
    "consola": "^3.4.2",
    "zod": "^4.1.13"
  },
  "devDependencies": {
    "@types/node": "^22.9.4",
    "dotenv": "^17.2.3",
    "tsup": "^8.5.0",
    "tsx": "^4.20.3",
    "turbo": "^2.7.6",
    "typescript": "^5.7.2",
    "vitest": "^3.2.4",
    "yaml": "^2.6.1"
  },
  "packageManager": "pnpm@10.9.0"
}
