{
  "name": "liturgical-calendar",
  "version": "2.1.0",
  "main": "./dist/index.js",
  "module": "./dist/index.mjs",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "require": "./dist/index.js",
      "import": "./dist/index.mjs"
    }
  },
  "browser": "./dist/index.js",
  "repository": "https://github.com/Sint-Willibrordkerk/liturgical-calendar.git",
  "author": "Sint Willibrordus Stichting",
  "description": "Generate a (local) Catholic liturgical calendar in accordance with the 1960 rubrics.",
  "license": "MIT",
  "scripts": {
    "build": "tsup",
    "start": "pnpm build && node scripts/main.js",
    "test": "vitest",
    "copySourceFiles": "node scripts/copy-source-files.mjs > out.log 2> out-err.log",
    "initialMigration": "node scripts/initial-migration.mjs > out.log 2> out-err.log",
    "resolveReferences": "node scripts/resolve-references.mjs > out.log 2> out-err.log"
  },
  "files": [
    "dist"
  ],
  "dependencies": {
    "zod": "^4.1.13"
  },
  "devDependencies": {
    "@types/node": "^22.9.4",
    "dotenv": "^17.2.3",
    "tsup": "^8.5.0",
    "turbo": "^2.7.6",
    "typescript": "^5.7.2",
    "vitest": "^3.2.4",
    "yaml": "^2.6.1"
  },
  "packageManager": "pnpm@10.9.0"
}
